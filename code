@bot.tree.command(name="purse", description="Check your coin pouch balances")
async def purse(interaction: discord.Interaction, player: discord.Member = None):
    target = player or interaction.user
    wallet = await get_wallet(target.id, interaction.guild_id)
    total_gp = (wallet["copper"] * 0.01) + (wallet["silver"] * 0.1) + wallet["gold"] + (wallet["platinum"] * 10)
    
    embed = discord.Embed(title=f"🎒 {target.display_name}'s Coin Pouch", color=discord.Color.dark_gold())
    embed.add_field(name="🟤 Copper (cp)", value=f"{wallet['copper']} cp", inline=True)
    embed.add_field(name="⚪ Silver (sp)", value=f"{wallet['silver']} sp", inline=True)
    embed.add_field(name="🟡 Gold (gp)", value=f"**{wallet['gold']} gp**", inline=True)
    embed.add_field(name="🪙 Platinum (pp)", value=f"{wallet['platinum']} pp", inline=True)
    embed.add_field(name="📊 Value Summary", value=f"`{total_gp:.2f} gp` net exchange", inline=False)
    await interaction.response.send_message(embed=embed)

@bot.tree.command(name="backpack", description="Inspect items in your inventory sheet")
async def backpack(interaction: discord.Interaction, player: discord.Member = None):
    target = player or interaction.user
    async with bot.db.execute(
        "SELECT item_name, quantity FROM player_inventory WHERE user_id = ? AND guild_id = ? AND quantity > 0",
        (target.id, interaction.guild_id)
    ) as cursor:
        rows = await cursor.fetchall()
        
    embed = discord.Embed(title=f"🎒 {target.display_name}'s Adventure Backpack", color=discord.Color.blue())
    if not rows:
        embed.description = "*This backpack is completely empty.*"
    else:
        for row in rows:
            embed.add_field(name=f"⚔️ {row[0]}", value=f"Quantity: **x{row[1]}**", inline=True)
    await interaction.response.send_message(embed=embed)

@bot.tree.command(name="use", description="Eat, drink, or consume items from your backpack")
async def use(interaction: discord.Interaction, item_name: str, quantity: int = 1):
    if quantity <= 0:
        await interaction.response.send_message("You must consume a positive quantity!", ephemeral=True)
        return

    clean_name = item_name.strip()
    async with bot.db.execute(
        "SELECT item_name, quantity FROM player_inventory WHERE user_id = ? AND guild_id = ? AND LOWER(item_name) = LOWER(?)",
        (interaction.user.id, interaction.guild_id, clean_name)
    ) as cursor:
        row = await cursor.fetchone()

    if not row:
        await interaction.response.send_message(f"⚠️ **Warning:** You do not have any '{clean_name}' in your backpack configuration!", ephemeral=True)
        return

    actual_name, current_qty = row[0], row[1]

    if current_qty < quantity:
        await interaction.response.send_message(
            f"❌ **Action Denied:** Insufficient items! You only have **{current_qty}x** left.", 
            ephemeral=True
        )
        return

    new_qty = current_qty - quantity
    await bot.db.execute(
        "UPDATE player_inventory SET quantity = ? WHERE user_id = ? AND guild_id = ? AND LOWER(item_name) = LOWER(?)",
        (new_qty, interaction.user.id, interaction.guild_id, clean_name)
    )
    await bot.db.commit()
    await interaction.response.send_message(f"🍄 **{interaction.user.display_name}** consumed **x{quantity} {actual_name}**.")

# ==================== DM SERVER GATEKEEPER INTERFACE ====================

@bot.tree.command(name="store_open", description="DM ONLY: Open the marketplace and set a custom greeting")
@app_commands.checks.has_permissions(administrator=True)
async def store_open(interaction: discord.Interaction, greeting: str = "Welcome to the shop!"):
    await bot.db.execute(
        "INSERT INTO shop_state (guild_id, is_open, greeting) VALUES (?, 1, ?) ON CONFLICT(guild_id) DO UPDATE SET is_open = 1, greeting = ?", 
        (interaction.guild_id, greeting, greeting)
    )
    await bot.db.commit()
    await interaction.response.send_message(f"🏪 **Market Open:** {greeting}")

@bot.tree.command(name="store_close", description="DM ONLY: Close down the marketplace")
@app_commands.checks.has_permissions(administrator=True)
async def store_close(interaction: discord.Interaction):
    await bot.db.execute(
        "INSERT INTO shop_state (guild_id, is_open) VALUES (?, 0) ON CONFLICT(guild_id) DO UPDATE SET is_open = 0", 
        (interaction.guild_id,)
    )
    await bot.db.commit()
    await interaction.response.send_message("❌ **Market Closed:** The merchant packing crates are locked up.")

