class CurrencyType(Enum):
    copper = "copper"
    silver = "silver"
    gold = "gold"
    platinum = "platinum"

class Bot(commands.Bot):
    def __init__(self):
        intents = discord.Intents.default()
        intents.message_content = True
        super().__init__(command_prefix="!", intents=intents)

    async def setup_hook(self):
        self.db = await aiosqlite.connect("dnd_advanced_economy.db")
        
        # 1. Wallets Table
        await self.db.execute("CREATE TABLE IF NOT EXISTS inventory (user_id INTEGER, guild_id INTEGER, copper INTEGER DEFAULT 0, silver INTEGER DEFAULT 0, gold INTEGER DEFAULT 0, platinum INTEGER DEFAULT 0, PRIMARY KEY (user_id, guild_id))")
        
        # 2. Interchangeable Shop Catalog Table
        await self.db.execute("CREATE TABLE IF NOT EXISTS shop_items (guild_id INTEGER, item_name TEXT, cost INTEGER, currency TEXT, description TEXT, PRIMARY KEY (guild_id, item_name))")

        # 3. Player Character Inventories Table
        await self.db.execute("CREATE TABLE IF NOT EXISTS player_inventory (user_id INTEGER, guild_id INTEGER, item_name TEXT, quantity INTEGER DEFAULT 0, PRIMARY KEY (user_id, guild_id, item_name))")

        # 4. Server Shop Control Table (Tracks open/closed state and custom greetings)
        await self.db.execute("CREATE TABLE IF NOT EXISTS shop_state (guild_id INTEGER PRIMARY KEY, is_open INTEGER DEFAULT 0, greeting TEXT DEFAULT 'Welcome to the shop!')")
        
        await self.db.commit()
        print("Database initialized completely (With DM Shop Gatekeeping & Dynamic Greetings).")

    async def close(self):
        await super().close()
        await self.db.close()

bot = Bot()

# Database Helper Functions
async def get_wallet(user_id: int, guild_id: int):
    async with bot.db.execute(
        "SELECT copper, silver, gold, platinum FROM inventory WHERE user_id = ? AND guild_id = ?",
        (user_id, guild_id)
    ) as cursor:
        row = await cursor.fetchone()
        if row:
            return {"copper": row[0], "silver": row[1], "gold": row[2], "platinum": row[3]}
        await bot.db.execute(
            "INSERT INTO inventory (user_id, guild_id, copper, silver, gold, platinum) VALUES (?, ?, 50, 20, 10, 0)",
            (user_id, guild_id)
        )
        await bot.db.commit()
        return {"copper": 50, "silver": 20, "gold": 10, "platinum": 0}

async def add_item_to_bag(user_id: int, guild_id: int, item_name: str, quantity: int):
    clean_name = item_name.strip()
    async with bot.db.execute(
        "SELECT quantity FROM player_inventory WHERE user_id = ? AND guild_id = ? AND LOWER(item_name) = LOWER(?)",
        (user_id, guild_id, clean_name)
    ) as cursor:
        row = await cursor.fetchone()
        if row:
            await bot.db.execute(
                "UPDATE player_inventory SET quantity = quantity + ? WHERE user_id = ? AND guild_id = ? AND LOWER(item_name) = LOWER(?)",
                (quantity, user_id, guild_id, clean_name)
            )
        else:
            await bot.db.execute(
                "INSERT INTO player_inventory (user_id, guild_id, item_name, quantity) VALUES (?, ?, ?, ?)",
                (user_id, guild_id, clean_name, quantity)
            )
    await bot.db.commit()

async def get_shop_state(guild_id: int):
    async with bot.db.execute("SELECT is_open, greeting FROM shop_state WHERE guild_id = ?", (guild_id,)) as cursor:
        row = await cursor.fetchone()
        if row:
            return {"is_open": bool(row[0]), "greeting": str(row[1])}
        return {"is_open": False, "greeting": "The merchant wagon has not arrived in town yet."}

